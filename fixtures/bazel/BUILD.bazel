load(":smoke.bzl", "smoke_copy", "smoke_large", "smoke_receipt", "smoke_test")

# Avoid Bazel's default host platform repository entirely.
platform(name = "local")

smoke_copy(name = "artifact", src = "payload.txt", nonce = "nonce.txt")
smoke_large(name = "large", src = "payload.txt", nonce = "nonce.txt")
smoke_receipt(name = "receipt", src = ":large", nonce = "nonce.txt")

smoke_test(name = "passing_test", exit_code = 0, nonce = "SMOKE_NONCE", size = "small")
smoke_test(name = "failing_test", exit_code = 1, nonce = "SMOKE_NONCE", size = "small")
